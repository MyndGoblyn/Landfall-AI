ENVIRONMENT=development
PORT=8001
MONGO_URL=mongodb://localhost:27017
DB_NAME=landfall_ai
JWT_SECRET=replace-with-at-least-32-random-characters
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
APP_PUBLIC_URL=http://localhost:3000
USE_IN_MEMORY_DB=false
REQUIRE_EMAIL_VERIFICATION=false
AUTH_COOKIE_NAME=landfall_session
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=
CAPTCHA_REQUIRED=false
TURNSTILE_SECRET_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=20
EMAIL_PROVIDER=smtp
EMAIL_FROM_NAME=LandFall AI
BREVO_API_KEY=
LOGIN_ATTEMPT_LIMIT=5
LOGIN_ATTEMPT_WINDOW_MINUTES=15
AUTH_ACTION_ATTEMPT_LIMIT=5
AUTH_ACTION_WINDOW_MINUTES=15
RESET_ACCOUNTS_KEY=
SCRYFALL_CATALOG_PATH=
CANDIDATE_CATALOG_ENABLED=true
CANDIDATE_CATALOG_EXPANSION_FACTOR=4
CANDIDATE_CATALOG_MAX_RESULTS=160
# Production defaults to https://landfallai.live/catalog/manifest.json.
CANDIDATE_CATALOG_REMOTE_ENABLED=true
SCRYFALL_CATALOG_MANIFEST_URL=
LANDFALL_CACHE_DIR=
CANDIDATE_CATALOG_REMOTE_TIMEOUT_SECONDS=30
CANDIDATE_CATALOG_MAX_COMPRESSED_BYTES=67108864
CANDIDATE_CATALOG_MAX_UNCOMPRESSED_BYTES=268435456
SCRYFALL_USER_AGENT=LandfallAI/1.0 (Commander recommendation service)
SCRYFALL_REQUEST_TIMEOUT_SECONDS=12
# The collection endpoint resolves up to 75 exact card names per request.
SCRYFALL_COLLECTION_INTERVAL_SECONDS=0.5
RECOMMENDATION_RANKER_MODE=v2
# raw restores count-only deck gaps; shadow reports quality gaps without serving them.
DECK_ROLE_ASSESSMENT_MODE=effective
