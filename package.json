{
  "name": "landfall-ai-cloudflare",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:frontend": "node cloudflare/build-frontend.mjs",
    "cf:dry-run": "npm run build:frontend && wrangler deploy --dry-run",
    "cf:dev": "npm run build:frontend && wrangler dev",
    "cf:deploy": "npm run build:frontend && wrangler deploy",
    "cf:whoami": "wrangler whoami",
    "cf:types": "wrangler types cloudflare/worker-configuration.d.ts",
    "cf:typecheck": "npm run cf:types && tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "wrangler": "4.157.0"
  }
}
